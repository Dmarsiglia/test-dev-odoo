<odoo>

    <record id="motorcycle_financing_search_view" model="ir.ui.view">
        <field name="name">motorcycle.financing.search.view</field>
        <field name="model">motorcycle.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="loan_amount"/>
                <field name="down_payment"/>
                <field name="interest_rate"/>
                <field name="loan_term"/>
                <field name="date_application"/>
                <field name="state"/>
                <filter name="filter_state_name" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_state_sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="filter_state_approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="filter_application_date" string="Aplication Date" date="date_application" start_month="-3"/>
                              
            </search>
        </field>
    </record>

    <record id="motorcycle_financing_form_view" model="ir.ui.view">
        <field name="name">motorcycle.financing.fprm.view</field>
        <field name="model">motorcycle.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,approved,rejected,signed" statusbar_colors='{"draft":"grey","sent":"blue","approved":"green","rejected":"red","signed":"darkgreen"}'/>
                </header>
                <sheet>
                    <group>
                        <h2>
                            <field name="name"/>
                        </h2>
                    </group>

                    <group>
                        <group>
                            <separator string="Customer Information"/>
                        </group>

                        <group>
                            <separator string="Application Information"/>
                            <group>
                                <field name="date_application"/>
                                <field name="loan_amount"/>
                                <field name="down_payment"/>
                            </group>
                            <group>
                                <field name="interest_rate"/>
                                <field name="loan_term"/>
                                <field name="state"/>
                            </group>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Dates">
                            <group>
                                <field name="date_approval"/>
                                <field name="date_rejection"/>
                                <field name="date_signed"/>
                            </group>
                        </page>
                        <page string="Rejection Reason">
                            <group>
                                <field name="rejection_reason"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Tags">
                            <group>
                                <field name="tags"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>                
            </form>
        </field>
    </record>

    <record id="motorcycle_financing_tree_view" model="ir.ui.view">
        <field name="name">motorcycle.financing.tree.view</field>
        <field name="model">motorcycle.loan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="loan_amount"/>
                <field name="down_payment"/>
                <field name="interest_rate"/>
                <field name="loan_term"/>
                <field name="date_application"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="loan_application_menu" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">motorcycle.loan</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>