<odoo>

    <!-- Categoría para agrupar los grupos (Esto SI es válido en Odoo 19) -->
    <record id="module_category_motorcycle_financing" model="ir.module.category">
        <field name="name">Motorcycle Dealership Financing</field>
        <field name="sequence">10</field>
    </record>

    <!-- Grupo básico -->
    <record id="motorcycle_financing_user" model="res.groups">
        <field name="name">Financing User</field>
        <!-- Incluye acceso base de usuario interno -->
        <!-- <field name="category_id" ref="module_category_motorcycle_financing"/> -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        
    </record>

    <!-- Grupo administrador -->
    <record id="motorcycle_financing_manager" model="res.groups">
        <field name="name">Financing Admin</field>
        <!-- Hereda permisos del grupo anterior -->
       <!--<field name="category_id" ref="module_category_motorcycle_financing"/> -->
        <field name="implied_ids" eval="[(4, ref('motorcycle_financing.motorcycle_financing_user'))]"/>
    </record>

</odoo>
