<odoo>
    <data noupdate="0">

        <!-- Categoría del módulo -->
        <record id="module_category_motorcycle_financing" model="ir.module.category">
            <field name="name">Motorcycle Financing</field>
            <field name="description">Manage motorcycle loan applications and financing</field>
            <field name="sequence">50</field>
        </record>

        <!-- Privilegio para el módulo -->
        <record id="res_groups_privilege_motorcycle_financing" model="res.groups.privilege">
            <field name="name">Motorcycle Financing</field>
            <field name="category_id" ref="module_category_motorcycle_financing"/>
            <field name="description">Access to motorcycle financing features</field>
        </record>

        <!-- Grupo básico de usuario -->
        <record id="motorcycle_financing_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_motorcycle_financing"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can view and create loan applications</field>
        </record>

        <!-- Grupo administrador -->
        <record id="motorcycle_financing_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_motorcycle_financing"/>
            <field name="implied_ids" eval="[(4, ref('motorcycle_financing_user'))]"/>
            <field name="comment">Full access to all motorcycle financing features and configuration</field>
        </record>

    </data>
</odoo>